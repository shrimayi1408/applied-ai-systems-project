flowchart LR
    subgraph Input
        CSV[(data/songs.csv)]
        PROF[User profile<br/>genre, mood, energy]
    end

    subgraph Core["Recommender (rule-based)"]
        LOAD[load_songs]
        SCORE[score_song<br/>weighted match + proximity]
        RANK[recommend_songs<br/>top-k + reasons]
    end

    subgraph Voice["Fine-tuned model: DJ Nova"]
        FACTS[derive_facts<br/>mood/genre match, energy fit]
        MODEL[flan-t5-small<br/>fine-tuned on DJ-voice data]
        FILL[fill_names<br/>code inserts title/artist]
        GUARD{validate<br/>faithful and safe?}
        FALL[plain_blurb fallback]
    end

    OUT[CLI output:<br/>score + DJ blurb + reasons]
    LOG[(dj_nova.log)]

    subgraph Checks["Testing and human review"]
        TRAIN[train_dj.py<br/>data/dj/train.jsonl]
        EVAL[evaluate_dj.py<br/>held-out songs, base vs tuned]
        UNIT[pytest unit tests]
        HUMAN([Human reads output<br/>and eval table])
    end

    CSV --> LOAD --> SCORE
    PROF --> SCORE
    SCORE --> RANK --> FACTS --> MODEL --> FILL --> GUARD
    GUARD -- pass --> OUT
    GUARD -- fail --> FALL --> OUT
    GUARD -. logs accept/reject .-> LOG
    TRAIN -. produces weights .-> MODEL
    EVAL -. measures .-> MODEL
    UNIT -. checks .-> GUARD
    UNIT -. checks .-> SCORE
    OUT --> HUMAN
    EVAL --> HUMAN
    LOG --> HUMAN
